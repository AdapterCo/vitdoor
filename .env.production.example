POSTGRES_DB=vitdoor
POSTGRES_USER=vitdoor
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=gere-uma-chave-aleatoria-com-no-minimo-32-caracteres

# Enquanto DNS, TLS e Cloudflare não estiverem configurados, use o IP público.
PUBLIC_BASE_URL=https://api.vitdoor.com.br
CORS_ORIGINS=https://app.vitdoor.com.br,https://player.vitdoor.com.br
STORAGE_DRIVER=local

HTTP_PORT=80

# Usadas somente pelo comando de criação/rotação do administrador master.
INITIAL_ADMIN_NAME=Administrador VitDoor
INITIAL_ADMIN_EMAIL=admin@vitdoor.com.br
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres
