datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Tenant {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  brandColor       String?  @default("#3b82f6")
  plan             String   @default("CUSTOM") // Campo legado; contratação usa maxScreens
  maxScreens       Int      @default(10)
  unlimitedScreens Boolean  @default(false)
  maxStorageMb     Int      @default(5000)
  status           String   @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELLED
  customDomain     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users           User[]
  screens         Screen[]
  medias          Media[]
  mediaFolders    MediaFolder[]
  layouts         Layout[]
  playlists       Playlist[]
  campaigns       Campaign[]
  proofOfPlays    ProofOfPlay[]
  emergencyAlerts EmergencyAlert[]
  tickets         MaintenanceTicket[]
  remoteCommands  RemoteCommand[]
  qrScans         QrScan[]
  ticketQueues    TicketQueue[]
}

model User {
  id               String     @id @default(uuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String     @unique
  passwordHash     String
  role             String     @default("ADMIN_CLIENT") // SUPER_ADMIN, ADMIN_CLIENT, OPERATOR, DESIGNER, VIEWER
  avatarUrl        String?
  active           Boolean    @default(true)
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdScreens   Screen[]   @relation("ScreenCreator")
  createdMedias    Media[]    @relation("MediaCreator")
  createdLayouts   Layout[]   @relation("LayoutCreator")
  createdPlaylists Playlist[] @relation("PlaylistCreator")
  createdMediaFolders MediaFolder[] @relation("MediaFolderCreator")
  createdCampaigns Campaign[] @relation("CampaignCreator")
  createdEmergencyAlerts EmergencyAlert[] @relation("EmergencyAlertCreator")
  createdRemoteCommands RemoteCommand[] @relation("RemoteCommandCreator")
}

model Screen {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation("ScreenCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  pairingCode String  @unique
  paired      Boolean @default(false)

  // Specs & Info
  orientation  String  @default("HORIZONTAL") // HORIZONTAL, VERTICAL
  resolution   String  @default("1920x1080")
  os           String? @default("Android TV")
  ipAddress    String?
  macAddress   String?
  locationName String? @default("Matriz / Loja 01")
  latitude     Float?
  longitude    Float?
  groupName    String? @default("Geral")
  tags         String? @default("Recepção, TV1")

  // Realtime Status & Hardware Telemetry
  status             String    @default("OFFLINE") // ONLINE, OFFLINE, WARNING
  lastPing           DateTime?
  volume             Int       @default(80)
  storageFreeMb      Int?
  ramUsagePercent    Int?
  cpuUsagePercent    Int?
  appVersion         String?
  currentMediaName   String?
  lastScreenshotUrl  String?
  deviceTokenVersion Int       @default(1)
  manifestVersion    Int       @default(1)

  // Active Content
  activePlaylistId String?
  activePlaylist   Playlist? @relation(fields: [activePlaylistId], references: [id], onDelete: SetNull)
  activeLayoutId   String?
  activeLayout     Layout?   @relation(fields: [activeLayoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proofOfPlays     ProofOfPlay[]
  tickets          MaintenanceTicket[]
  pairingSession   PairingSession?
  emergencyTargets EmergencyAlertTarget[]
  remoteCommands   RemoteCommand[]
  manifests        ScreenManifest[]
  qrScans          QrScan[]
  ticketQueues     TicketQueue[]
}

model ScreenManifest {
  id        String   @id @default(uuid())
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  version   Int
  checksum  String
  payload   String
  createdAt DateTime @default(now())

  @@unique([screenId, version])
  @@index([screenId, createdAt])
}

model PairingSession {
  id         String    @id @default(uuid())
  code       String    @unique
  secretHash String
  expiresAt  DateTime
  claimedAt  DateTime?
  screenId   String?   @unique
  screen     Screen?   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

model Media {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?     @relation("MediaCreator", fields: [createdById], references: [id], onDelete: SetNull)
  folderId        String?
  folder          MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name            String
  type            String // IMAGE, VIDEO, AUDIO, WEB_PAGE, HTML, RSS
  url             String
  storagePath     String?
  thumbnailUrl    String?
  durationSeconds Int       @default(10)
  sizeBytes       BigInt?   @default(0)
  tags            String?
  validUntil      DateTime?
  checksum        String?
  mimeType        String?
  version         Int       @default(1)
  ctaJson         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlistItems PlaylistItem[]
  qrScans       QrScan[]
}

model MediaFolder {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("MediaFolderCreator", fields: [createdById], references: [id], onDelete: Cascade)
  name        String
  medias      Media[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([createdById, name])
  @@index([tenantId, createdById])
}

model Layout {
  id               String  @id @default(uuid())
  tenantId         String
  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?   @relation("LayoutCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name             String
  description      String?
  orientation      String  @default("HORIZONTAL")
  canvasConfigJson String // JSON string representing layout regions (Zones A/B/C, Ticker, RSS, Clock, Weather)
  isTemplate       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screens       Screen[]
  playlistItems PlaylistItem[]
}

model Playlist {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation("PlaylistCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  description String?
  category    String? @default("Geral")
  isLoop      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PlaylistItem[]
  screens   Screen[]
  campaigns Campaign[]
}

model PlaylistItem {
  id              String   @id @default(uuid())
  playlistId      String
  playlist        Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaId         String?
  media           Media?   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  layoutId        String?
  layout          Layout?  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  orderIndex      Int      @default(0)
  durationSeconds Int      @default(10)
}

model Campaign {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById        String?
  createdBy          User?     @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name               String
  advertiserName     String?
  playlistId         String?
  playlist           Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  startDate          DateTime
  endDate            DateTime
  daysOfWeek         String    @default("1,2,3,4,5,6,0") // 0=Sunday, 1=Monday...
  startTime          String    @default("00:00")
  endTime            String    @default("23:59")
  priority           Int       @default(1)
  maxImpressions     Int?
  currentImpressions Int       @default(0)
  status             String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProofOfPlay {
  id              String   @id @default(uuid())
  eventId         String
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  screenId        String
  screen          Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  mediaName       String
  playedAt        DateTime @default(now())
  durationSeconds Int
  completed       Boolean  @default(true)

  @@unique([screenId, eventId])
}

model RemoteCommand {
  commandId   String   @id
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  screenId    String
  screen      Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("RemoteCommandCreator", fields: [createdById], references: [id], onDelete: Cascade)
  action      String
  payloadJson String?
  status      String   @default("PENDING") // PENDING, SENT, SUCCEEDED, FAILED, EXPIRED
  success     Boolean?
  message     String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  sentAt      DateTime?
  completedAt DateTime?

  @@index([screenId, status, createdAt])
  @@index([tenantId, createdById, createdAt])
}

model EmergencyAlert {
  id              String                 @id @default(uuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?                  @relation("EmergencyAlertCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title           String
  message         String
  alertType       String                 @default("WARNING") // INFO, WARNING, EVACUATION, URGENT
  active          Boolean                @default(true)
  durationSeconds Int                    @default(60)
  createdAt       DateTime               @default(now())
  targets         EmergencyAlertTarget[]

  @@index([tenantId, createdById])
}

model EmergencyAlertTarget {
  alertId  String
  screenId String
  alert    EmergencyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  screen   Screen         @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@id([alertId, screenId])
}

model MaintenanceTicket {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  screenId       String
  screen         Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  title          String
  description    String
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status         String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  technicianName String?
  photoUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model QrScan {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  screenId   String?
  screen     Screen?  @relation(fields: [screenId], references: [id], onDelete: SetNull)
  ctaType    String   // WHATSAPP, INSTAGRAM
  scannedAt  DateTime @default(now())
  userAgent  String?

  @@index([tenantId, scannedAt])
  @@index([mediaId, scannedAt])
  @@index([screenId, scannedAt])
}

model TicketQueue {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String        // ex: "Atendimento Geral", "Açougue", "Consultório 1"
  prefix       String        @default("") // ex: "A", "P", "C", ou ""
  currentNum   Int           @default(0)
  pinCode      String        // PIN único de 4-6 dígitos para acesso do operador (ex: 1234)
  deskName     String        @default("Guichê 01") // ex: "Consultório 03", "Balcão 02"
  screenId     String?
  screen       Screen?       @relation(fields: [screenId], references: [id], onDelete: SetNull)
  tickets      QueueTicket[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@index([pinCode])
}

model QueueTicket {
  id           String      @id @default(uuid())
  queueId      String
  queue        TicketQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  ticketNumber String      // ex: "A042" ou "042"
  deskName     String      // ex: "Consultório 03"
  status       String      @default("CALLED") // CALLED, COMPLETED, CANCELLED
  calledAt     DateTime    @default(now())

  @@index([queueId, calledAt])
}
