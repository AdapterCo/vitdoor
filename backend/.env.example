DATABASE_URL="postgresql://vitdoor:senha@localhost:5432/vitdoor?schema=public"
PORT=4000
NODE_ENV=development
STORAGE_DRIVER=local
PUBLIC_BASE_URL=https://api.vitdoor.com.br
CORS_ORIGINS=https://app.vitdoor.com.br,https://player.vitdoor.com.br
JWT_SECRET=replace-with-a-long-random-secret

# Cloudflare R2 (obrigatório quando STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vitdoor-media
R2_PUBLIC_URL=https://media.vitdoor.com.br
# Necessário para invalidar da CDN uma mídia removida que já tenha sido cacheada.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
